params {
    input               = null   // samplesheet CSV, required (see assets/samplesheet.csv)

    fasta               = 's3://CHANGE-ME-bucket/genome/genome.fasta'
    gtf                 = 's3://CHANGE-ME-bucket/genome/annotation.gtf'

    star_index_bucket   = 's3://CHANGE-ME-bucket/star-index'   // holds star_index/ and rsem_ref/
    rsem_ref_prefix     = 'rsem_ref'
    star_sjdb_overhang  = 100                                   // tune to (read_length - 1)

    outdir              = './results'
    workdir_s3          = 's3://CHANGE-ME-bucket/nf-work'      // Nextflow's own S3 work dir

    aws_batch_queue     = 'CHANGE-ME-queue'
    aws_region          = 'us-west-2'
}

process {
    withLabel: 'low_cpu' {
        cpus   = 2
        memory = '4.GB'
    }
    withLabel: 'mid_cpu' {
        cpus   = 8
        memory = '16.GB'
    }
    withLabel: 'high_cpu' {
        cpus   = 16
        memory = '64.GB'   // STAR genomeGenerate/align headroom
    }
}

manifest {
    name            = 'nf-practice-rnaseq'
    description     = 'Toy bulk RNA-seq pipeline: fastp -> STAR -> RSEM -> MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

profiles {
    awsbatch { includeConfig 'conf/awsbatch.config' }
    local    { includeConfig 'conf/local.config' }
}

process.executor = 'awsbatch'
process.queue    = params.aws_batch_queue

aws.region = params.aws_region

workDir = params.workdir_s3

// aws.batch.cliPath = '/usr/bin/aws'
// Uncomment only if the Batch compute environment's AMI lacks the AWS CLI at
// the default path; the standard ECS-optimized AMI usually doesn't need this.
